# Copy to .env and fill in what you have. Everything is optional in Phase 0:
# without DATABASE_URL the CLI uses an on-disk PGlite database in .data/.

# Postgres for production. Leave empty to use PGlite locally.
DATABASE_URL=

# Claude API, used by the extractor and the resolver's tie-breaker.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
REASONING_MODEL=claude-opus-5-5

# Harmonic REST API key (console.harmonic.ai).
HARMONIC_API_KEY=

# SEC requires a descriptive User-Agent with contact info for EDGAR requests.
SEC_USER_AGENT="VC OS research you@example.com"

# Granola's hosted MCP server uses OAuth. Paste a bearer token here for
# headless runs, or leave empty and export transcripts to files instead.
GRANOLA_MCP_URL=https://mcp.granola.ai/mcp
GRANOLA_TOKEN=
