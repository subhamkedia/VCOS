# Copy to .env and fill in what you have. Every key is optional: a connector
# without its keys is skipped. `pnpm connectors` shows what's configured and
# `pnpm connectors --check` tests each one with a single live call.

# Postgres for production. Leave empty to use PGlite locally (.data/).
DATABASE_URL=

# --- Web app ------------------------------------------------------------------
# Public URL; OAuth redirect URI is APP_URL/api/auth/callback.
APP_URL=http://localhost:8787
PORT=8787
# Encrypts every firm's connector credentials. Required in production:
# openssl rand -base64 32. In development a key is generated in .data/.
VCOS_SECRET_KEY=
# Sign-in links and invitations. Without a key they're printed to the log.
RESEND_API_KEY=
MAIL_FROM="VC OS <login@yourdomain.com>"

# Vendor keys below are for the local CLI. In the web app each firm adds its
# own under Connections; the server's .env keys are never lent to a firm.

# --- Claude -----------------------------------------------------------------
# Extraction and the resolver's tie-breaker. Without it, evidence is stored
# but no claims are extracted.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
REASONING_MODEL=claude-opus-5-5

# --- Data vendors (vendor scope: stays internal, never exported) ------------
# Harmonic REST API key (console.harmonic.ai).
HARMONIC_API_KEY=
# PitchBook API key (licensed per firm; ask your PitchBook rep).
PITCHBOOK_API_KEY=
# Crunchbase API v4 user key (Crunchbase Enterprise or API plan).
CRUNCHBASE_API_KEY=
# Dealroom API key.
DEALROOM_API_KEY=

# --- Public sources ----------------------------------------------------------
# SEC requires a descriptive User-Agent with contact info for EDGAR requests.
SEC_USER_AGENT="VC OS research you@example.com"
# USPTO PatentsView PatentSearch API: free key from patentsview.org (a
# platform key: every firm's diligence uses it for granted patents).
PATENTSVIEW_API_KEY=
# News (GDELT), SBIR.gov, USAspending.gov and company job boards need no key.
# The YC directory needs no key (network access to yc-oss.github.io,
# www.ycombinator.com and hn.algolia.com).

# --- CRM ---------------------------------------------------------------------
# Affinity: Settings -> API -> generate a key. Notes are written only after
# you approve them in `pnpm outbox`.
AFFINITY_API_KEY=

# --- Google Workspace: sign-in, Gmail, Drive -----------------------------------
# One OAuth client for all three, shared by every firm on this server. In
# Google Cloud console: create an OAuth client of type "Web application" with
# redirect URI APP_URL/api/auth/callback, and enable the Gmail, Drive,
# Calendar and Meet APIs. A firm connects Google once: one consent covers the
# products it picks, and adding one later asks only for the new permission
# (incremental authorization). Scopes: gmail.readonly, gmail.compose (drafts
# only; VC OS never sends), drive.readonly, calendar.events.readonly and
# meetings.space.readonly.
# GOOGLE_REFRESH_TOKEN is only for the local CLI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Microsoft 365: sign-in and Outlook -------------------------------------------
# One Entra ID app registration: redirect URI APP_URL/api/auth/callback,
# delegated permissions offline_access, User.Read, Mail.Read, Mail.ReadWrite
# (drafts only), Calendars.Read, OnlineMeetings.Read and
# OnlineMeetingTranscript.Read.All (Teams transcripts; needs admin consent). MS_TENANT is "common" for any work account,
# or one tenant id. MS_REFRESH_TOKEN is only for the local CLI.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_TENANT=common

# --- Meetings -------------------------------------------------------------------
# Zoom: one user-managed OAuth app for the server (marketplace.zoom.us), redirect
# URI APP_URL/api/auth/callback, scopes cloud_recording:read:list_user_recordings,
# meeting:read:list_past_participants and user:read:user. Each firm connects its
# own Zoom account in the app. ZOOM_REFRESH_TOKEN is only for the local CLI.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REFRESH_TOKEN=
# Granola public API key (Settings -> Connectors -> API keys; Business plan).
GRANOLA_API_KEY=
# Fireflies.ai API key (Integrations -> Fireflies API).
FIREFLIES_API_KEY=

# --- Closing (Investment Execution) ---------------------------------------------
# DocuSign: one OAuth app (integration key) for the server, redirect URI
# APP_URL/api/auth/callback, scopes "signature extended". Firms connect their
# own DocuSign account; VC OS reads envelope status and can prepare draft
# envelopes that a person sends. Use account-d.docusign.com for the sandbox.
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_AUTH_SERVER=account.docusign.com
DOCUSIGN_REFRESH_TOKEN=
# Carta API Platform (invite-only partner access): the firm's client
# credentials. Cap table CSV exports work without it.
CARTA_CLIENT_ID=
CARTA_CLIENT_SECRET=
CARTA_API_BASE=https://api.carta.com
# OFAC sanctions lists need no key.

# --- Portfolio -------------------------------------------------------------
# Founders connect their company's books from the link the firm sends them.
# One app registration each, for every firm. Redirect URI for both:
# APP_URL/api/portal/callback
# QuickBooks Online (developer.intuit.com): scope com.intuit.quickbooks.accounting.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production
# Xero (developer.xero.com): granular read-only report scopes plus offline_access.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# A firm that already collects KPIs in Standard Metrics or Visible adds its
# own keys under Connections; these are for the CLI.
STANDARD_METRICS_CLIENT_ID=
STANDARD_METRICS_CLIENT_SECRET=
VISIBLE_API_TOKEN=
