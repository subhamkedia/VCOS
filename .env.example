# Copy to .env and fill in what you have. Every key is optional: a connector
# without its keys is skipped. `pnpm connectors` shows what's configured and
# `pnpm connectors --check` tests each one with a single live call.

# Postgres for production. Leave empty to use PGlite locally (.data/).
DATABASE_URL=

# --- Web app ------------------------------------------------------------------
# Public URL; OAuth redirect URI is APP_URL/api/auth/callback.
APP_URL=http://localhost:8787
PORT=8787
# Encrypts every firm's connector credentials. Required in production:
# openssl rand -base64 32. In development a key is generated in .data/.
VCOS_SECRET_KEY=
# Sign-in links and invitations. Without a key they're printed to the log.
RESEND_API_KEY=
MAIL_FROM="VC OS <login@yourdomain.com>"

# Vendor keys below are for the local CLI. In the web app each firm adds its
# own under Connections; the server's .env keys are never lent to a firm.

# --- Claude -----------------------------------------------------------------
# Extraction and the resolver's tie-breaker. Without it, evidence is stored
# but no claims are extracted.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
REASONING_MODEL=claude-opus-5-5

# --- Data vendors (vendor scope: stays internal, never exported) ------------
# Harmonic REST API key (console.harmonic.ai).
HARMONIC_API_KEY=
# PitchBook API key (licensed per firm; ask your PitchBook rep).
PITCHBOOK_API_KEY=
# Crunchbase API v4 user key (Crunchbase Enterprise or API plan).
CRUNCHBASE_API_KEY=
# Dealroom API key.
DEALROOM_API_KEY=

# --- Public sources ----------------------------------------------------------
# SEC requires a descriptive User-Agent with contact info for EDGAR requests.
SEC_USER_AGENT="VC OS research you@example.com"
# The YC directory needs no key (network access to yc-oss.github.io,
# www.ycombinator.com and hn.algolia.com).

# --- CRM ---------------------------------------------------------------------
# Affinity: Settings -> API -> generate a key. Notes are written only after
# you approve them in `pnpm outbox`.
AFFINITY_API_KEY=

# --- Google Workspace: sign-in, Gmail, Drive -----------------------------------
# One OAuth client for all three, shared by every firm on this server. In
# Google Cloud console: create an OAuth client of type "Web application" with
# redirect URI APP_URL/api/auth/callback, and enable the Gmail and Drive APIs.
# When someone connects Gmail or Drive in the app, their consent gives their
# firm its own refresh token (stored encrypted). Scopes: gmail.readonly,
# gmail.compose (drafts only; VC OS never sends) and drive.readonly.
# GOOGLE_REFRESH_TOKEN is only for the local CLI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Microsoft 365: sign-in and Outlook -------------------------------------------
# One Entra ID app registration: redirect URI APP_URL/api/auth/callback,
# delegated permissions offline_access, User.Read, Mail.Read and
# Mail.ReadWrite (drafts only). MS_TENANT is "common" for any work account,
# or one tenant id. MS_REFRESH_TOKEN is only for the local CLI.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_TENANT=common

# --- Meetings -------------------------------------------------------------------
# Granola's hosted MCP server uses OAuth. Paste a bearer token here for
# headless runs, or leave empty and export transcripts to files instead.
GRANOLA_MCP_URL=https://mcp.granola.ai/mcp
GRANOLA_TOKEN=
